@page
@model EmailModel
@{
    bool semLayout = !string.IsNullOrEmpty(Model.IdUsuario);
    if (semLayout)
    {
        Layout = null;
    }
    else
    {
        ViewData["Title"] = "Manage Email";
        ViewData["ActivePage"] = ManageNavPages.Email;
    }
}

@if (semLayout)
{
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetDiverse.styles.css" asp-append-version="true" />
    <style>body { margin: 0; overflow-x: hidden; }</style>
}
else
{
    <h3>Alterar e-mail</h3>
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="@(semLayout ? "p-3" : "row")">
    <div class="@(semLayout ? "" : "col-md-6")">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />
            @if (Model.IsEmailConfirmed)
            {
                <div class="form-floating mb-3 input-group">
                    <input asp-for="Email" class="form-control" placeholder="Por favor, insira seu e-mail." disabled />
                    <div class="input-group-append">
                        <span class="h-100 input-group-text text-success font-weight-bold">✓</span>
                    </div>
                    <label asp-for="Email" class="form-label">E-mail atual</label>
                </div>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Por favor, insira seu e-mail." disabled />
                    <label asp-for="Email" class="form-label">E-mail atual</label>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link">Enviar e-mail de verificação</button>
                </div>
            }
            <div class="form-floating mb-3">
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Por favor, insira seu novo e-mail." />
                <label asp-for="Input.NewEmail" class="form-label">E-mail novo</label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg btn-roxo">Alterar</button>
        </form>
    </div>
</div>

@if (semLayout)
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
else
{
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
}
