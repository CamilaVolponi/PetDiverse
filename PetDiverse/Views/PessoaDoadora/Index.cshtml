@{
    ViewData["Title"] = "Index";
}
<h1 class="text-center">Usuários</h1>

<div class="d-flex justify-content-end mb-2">
    <input type="checkbox" id="mostrarExcluidos" class="form-check-input me-2" />
    <label for="mostrarExcluidos" class="form-check-label">Mostrar também os excluídos</label>
</div>

<table class="table" id="tabelaUsuarios">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Tipo</th>
            <th>Admin</th>
            <th>Data de exclusão</th>
            <th>Ações</th>
        </tr>
    </thead>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $("#tabelaUsuarios").DataTable({
                order: [[0, "asc"]],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                lengthChange: false,
                pageLength: 10,
                drawCallback: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                initComplete: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                ajax: {
                    url: "/PessoaDoadora/GetForTable",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "nome",
                        render: function (data, type, row) {
                            return `<a class="link-roxo" href="/PessoaDoadora/Details?id=${row.id}">${data}</a>`;
                        }
                    },
                    { data: "tipo" },
                    {
                        data: "isAdmin",
                        render: function (data) {
                            return data ? "Admin" : "Não é admin";
                        }
                    },
                    {
                        data: "dataExclusao",
                        visible: false,
                        render: function (data) {
                            return data ?? "-";
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            if (row.isSelf || row.dataExclusao) {
                                return `
                                <div class="dropdown">
                                    <button class="btn btn-secondary dropdown-roxo" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <p class="px-3 mb-0">Não existem ações disponíveis.</p>
                                    </div>
                                </div>`;
                            }

                            let adminAction = row.isAdmin
                                ? `<a class="dropdown-item text-danger" href="/PessoaDoadora/RemoverAdmin/${row.id}">Retirar permissão de admin</a>`
                                : `<a class="dropdown-item" href="/PessoaDoadora/TornarAdmin/${row.id}">Tornar admin</a>`;

                            return `
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-roxo" type="button" id="dropdownMenuButton_${row.id}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton_${row.id}">
                                    <a class="dropdown-item" href="/PessoaDoadora/Edit?idUsuario=${row.idUsuario}">Editar</a>
                                    <a class="dropdown-item text-danger" href="/PessoaDoadora/Delete/${row.id}">Desativar</a>
                                    <hr class="dropdown-divider" />
                                    ${adminAction}
                                </div>
                            </div>`;
                        }
                    }
                ]
            });

            
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (settings.nTable.id !== "tabelaUsuarios") return true;
                var mostrar = $("#mostrarExcluidos").is(":checked");
                var row = table.row(dataIndex).data();
                return mostrar || !row.dataExclusao;
            });

            $("#mostrarExcluidos").change(function () {
                table.column(3).visible($(this).is(":checked"));
                table.draw();
            });
        });
    </script>
}
