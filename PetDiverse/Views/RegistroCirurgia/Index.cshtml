@model IEnumerable<PetDiverse.Data.RegistroCirurgia>

@{
    ViewData["Title"] = "Registros de cirurgias";
    var idAnimal = ViewData["IdAnimal"];
}

<h2 class="text-center">Registros de Cirurgia de @ViewData["NomeAnimal"]</h2>

<p>
    <a asp-action="Create" asp-route-idAnimal="@idAnimal" class="btn btn-roxo">+ Adicionar</a>
</p>

<table class="table" id="tabelaRegistrosCirurgias">
    <thead>
        <tr>
            <th>
                Data da cirurgia
            </th>
            <th>
                Cirurgia
            </th>
            <th>
                Ações
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DataRegistro.ToString("dd/MM/yyyy")</td>
                <td>@Html.DisplayFor(modelItem => item.TipoCirurgia.Descricao)</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-roxo" type="button" id="dropdownMenuButton_@item.Id" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> </button>
                        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton_@item.Id">
                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <a class="dropdown-item" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#tabelaRegistrosCirurgias").DataTable({
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                drawCallback: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                initComplete: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                }
            });
        });
    </script>
}