@model IQueryable<PetDiverse.Data.Animal>

@{
    ViewData["Title"] = "Quero adotar!";
}
<div class="container">
    <div class="row">
        <h2>Escolha um novo amigo</h2>
    </div>
    <form method="get" asp-action="Index" asp-controller="" class="row g-2 mb-5 align-items-stretch">
        <div class="col-lg-2 col-md-4 col-sm-6">
            <select id="IdTipoAnimal" name="IdTipoAnimal" class="form-control" asp-items="ViewBag.IdTipoAnimal"><option value="">Selecione um tipo de animal</option></select>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
            <select id="IdEstado" name="IdEstado" class="form-control" asp-items="ViewBag.IdEstado"><option value="">Selecione um estado</option></select>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
            <select id="IdCidade" name="IdCidade" class="form-control" asp-items="ViewBag.IdCidade"><option value="">Selecione uma cidade</option></select>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
            <select id="IdBairro" name="IdBairro" class="form-control" asp-items="ViewBag.IdBairro"><option value="">Selecione um bairro</option></select>
        </div>
        <div class="col-lg-4 col-md-2 col-sm-12 d-flex">
            <button type="submit" class="btn btn-roxo w-100">Pesquisar</button>
        </div>
    </form>

    <div class="row">
        @foreach (var animal in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card h-100">
                    <img src="@animal.CaminhoFoto.Replace("wwwroot", "")" class="img-pet-card" width="100" height="250">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@animal.Nome</h5>
                        @{
                            var unidade = animal.Idade == 1
                                ? (animal.ContagemIdade == PetDiverse.Data.Enuns.ContagemIdade.Dias ? "dia"
                                   : animal.ContagemIdade == PetDiverse.Data.Enuns.ContagemIdade.Meses ? "mês"
                                   : "ano")
                                : animal.ContagemIdade.ToString().ToLower();
                        }
                        <p class="card-text mb-0">@animal.Idade @unidade</p>
                        <p class="card-text">
                            @(animal.PessoaDoadora.Bairro.Nome + ", " + animal.PessoaDoadora.Bairro.Cidade.Nome + ", " + animal.PessoaDoadora.Bairro.Cidade.Estado.Sigla)
                        </p>
                        <a class="btn btn-roxo mt-auto text-center" asp-controller="Animal" asp-action="Details" asp-route-id="@animal.Id"> Mais informações</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <p class="text-center mt-3">
        Página @ViewBag.CurrentPage de @ViewBag.TotalPages
    </p>
    <nav>
        <ul class="pagination pagination-roxo justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-idTipoAnimal="@ViewBag.IdTipoAnimalSelecionado"
                   asp-route-idEstado="@ViewBag.IdEstadoSelecionado"
                   asp-route-idCidade="@ViewBag.IdCidadeSelecionado"
                   asp-route-idBairro="@ViewBag.IdBairroSelecionado">
                    « Anterior
                </a>
            </li>
            @{
                int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
            }
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-idTipoAnimal="@ViewBag.IdTipoAnimalSelecionado"
                       asp-route-idEstado="@ViewBag.IdEstadoSelecionado"
                       asp-route-idCidade="@ViewBag.IdCidadeSelecionado"
                       asp-route-idBairro="@ViewBag.IdBairroSelecionado">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-idTipoAnimal="@ViewBag.IdTipoAnimalSelecionado"
                   asp-route-idEstado="@ViewBag.IdEstadoSelecionado"
                   asp-route-idCidade="@ViewBag.IdCidadeSelecionado"
                   asp-route-idBairro="@ViewBag.IdBairroSelecionado">
                    Próximo »
                </a>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script>
        (function () {
            function atualizarSelect2(id) {
                if (window.jQuery && jQuery.fn && jQuery.fn.select2) {
                    jQuery('#' + id).trigger('change.select2');
                }
            }

            function carregarCidades(idEstado) {
                var cidadeEl = document.getElementById('IdCidade');
                var bairroEl = document.getElementById('IdBairro');
                cidadeEl.innerHTML = '<option value="">Selecione uma cidade</option>';
                bairroEl.innerHTML = '<option value="">Selecione um bairro</option>';
                atualizarSelect2('IdCidade');
                atualizarSelect2('IdBairro');
                if (!idEstado) return;
                fetch('/Home/RecuperarCidades?id=' + idEstado)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        data.forEach(function (item) {
                            cidadeEl.appendChild(new Option(item.text, item.value));
                        });
                        atualizarSelect2('IdCidade');
                    });
            }

            function carregarBairros(idCidade) {
                var bairroEl = document.getElementById('IdBairro');
                bairroEl.innerHTML = '<option value="">Selecione um bairro</option>';
                atualizarSelect2('IdBairro');
                if (!idCidade) return;
                fetch('/Home/RecuperarBairros?id=' + idCidade)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        data.forEach(function (item) {
                            bairroEl.appendChild(new Option(item.text, item.value));
                        });
                        atualizarSelect2('IdBairro');
                    });
            }

            document.getElementById('IdEstado').onchange = function () { carregarCidades(this.value); };
            document.getElementById('IdCidade').onchange = function () { carregarBairros(this.value); };

            if (window.jQuery && jQuery.fn && jQuery.fn.select2) {
                var s2 = { allowClear: true, width: '100%', minimumResultsForSearch: 0 };
                jQuery('#IdTipoAnimal').select2(jQuery.extend({}, s2, { placeholder: 'Tipo de animal' }));
                jQuery('#IdEstado').select2(jQuery.extend({}, s2, { placeholder: 'Estado' }));
                jQuery('#IdCidade').select2(jQuery.extend({}, s2, { placeholder: 'Cidade' }));
                jQuery('#IdBairro').select2(jQuery.extend({}, s2, { placeholder: 'Bairro' }));
            }
        })();
    </script>
}