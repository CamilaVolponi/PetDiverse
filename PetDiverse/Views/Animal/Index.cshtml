@{
    ViewData["Title"] = "Index";
    bool isAdmin = User.IsInRole("ADMIN");
}
<h1 class="text-center">@(isAdmin ? "Todos os animais" : "Meus animais")</h1>
<div class="row">
    <div class="col-md-9">
        <p>
            <a asp-action="Create" class="btn btn-roxo">+ Adicionar</a>
        </p>
    </div>
    <div class="col-md-3 d-flex d-flex align-items-center justify-content-end">
        <input type="checkbox" id="mostrarAdotados" class="form-check-input me-2" />
        <label for="mostrarAdotados" class="form-check-label">Mostrar também os adotados</label>
    </div>
</div>
<table class="table" id="tabelaAnimais">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Idade</th>
            <th>Sexo biológico</th>
            <th>Porte</th>
            <th>Tipo de animal</th>
            <th>Raça</th>
            @if (User.IsInRole("ADMIN"))
            {
                <th>Doador</th>
            }
            <th>Adotado</th>
            <th>Ações</th>
        </tr>
    </thead>
</table>

@section Scripts {    
    <script>
        $(document).ready(function () {
            var table = $("#tabelaAnimais").DataTable({
                order: [[0, "asc"]],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                lengthChange: false,  // Remove o "Exibir X resultados por página"
                pageLength: 10,
                drawCallback: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                initComplete: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                // Ativa o processamento no servidor
                serverSide: true,
                processing: true,
                ajax: {
                    url: "/odata/Animal",
                    type: "GET",
                    // OData precisa desse parâmetro para retornar o total de linhas
                    data: function (d) {
                        var params = {
                            "$count": "true",
                            "$skip": d.start,
                            "$top": d.length,
                            "$expand": "TipoAnimal,Raca,PessoaDoadora",
                        };

                        // Ordenação
                        var colunas = ["Nome", "Idade", "SexoBiologico", "Porte", "TipoAnimal/Descricao", "Raca/Descricao", "PessoaDoadora/Nome", "Adotado"];
                        if (d.order && d.order.length > 0) {
                            var colIdx = d.order[0].column;
                            var dir = d.order[0].dir;
                            var colName = colunas[colIdx];
                            if (colName) {
                                params["$orderby"] = colName + " " + dir;
                            }
                        }

                        // Lógica de Filtro Combinada
                        var filtros = [];
                               
                        if (!$('#mostrarAdotados').is(':checked')) {
                            filtros.push("Adotado eq false");
                        }

                        // Se o usuário digitou algo na busca do DataTable
                        if (d.search.value) {
                            filtros.push("contains(Nome, '" + d.search.value + "')");
                        }

                        // Une os filtros com 'and' para o OData (ex: "Adotado eq true and contains(...)")
                        if (filtros.length > 0) {
                            params["$filter"] = filtros.join(" and ");
                        }

                        return params;
                    },
                    dataSrc: "value",
                    dataFilter: function (data) {
                        var json = jQuery.parseJSON(data);
                        // O @@ escapa o caractere para o Razor não dar erro
                        json.recordsTotal = json["@@odata.count"];
                        json.recordsFiltered = json["@@odata.count"];
                        return JSON.stringify(json);
                    }
                },  
                columns: [
                    { data: "Nome",
                        render: function (data, type, row) {
                            let link = `<a class="link-roxo" href="/Animal/Details?id=${row.Id}">${data}</a>`;
                            return link;
                        }
                    },
                    {
                        data: "Idade",
                        render: function (data, type, row) {
                            var c = row.ContagemIdade;
                            var isDias  = c === "Dias"  || c === 1;
                            var isMeses = c === "Meses" || c === 2;
                            var unidade;
                            if (data === 1) {
                                unidade = isDias ? "dia" : isMeses ? "mês" : "ano";
                            } else {
                                unidade = isDias ? "dias" : isMeses ? "meses" : "anos";
                            }
                            return data + " " + unidade;
                        }
                    },
                    { data: "SexoBiologico" },
                    { data: "Porte" },
                    {
                        data: "TipoAnimal.Descricao", 
                        defaultContent: "Não informada" 
                    },
                    {
                        data: "Raca.Descricao", 
                        defaultContent: "Não informada" 
                    },
                    @if (User.IsInRole("ADMIN")){
                        <text>
                            {
                                data: "PessoaDoadora.Nome",
                                render: function (data, type, row) {
                                    let link = `<a class="link-roxo" href="/PessoaDoadora/Details?id=${row.IdPessoaDoadora}">${data}</a>`;
                                    return link;
                                }
                            },
                        </text>
                    }
                    {
                        data: "Adotado",
                        visible: false,  // esconde por padrão
                        render: function(data) {
                            return data ? "Sim" : "Não";
                        }
                    },
                    {
                        data: null, // Não vem de um campo específico, usamos o objeto inteiro
                        orderable: false,
                        render: function (data, type, row) {
                            // 'row' contém todos os dados do animal, inclusive o Id e se está Adotado

                            let dropdown = `
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-roxo" type="button" id="dropdownMenuButton_${row.Id}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fas fa-ellipsis-v"></i> </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton_${row.Id}">
                                    <a class="dropdown-item" href="/Animal/Edit/${row.Id}">Editar</a>
                                    <a class="dropdown-item" href="/RegistroVacina?idAnimal=${row.Id}">Vacinas</a>
                                    <a class="dropdown-item" href="/RegistroCirurgia?idAnimal=${row.Id}">Cirurgias</a>

                                    ${!row.Adotado ?
                                        `<button class="dropdown-item btn-adocao" data-id="${row.Id}">Foi adotado</button>` :
                                        ''
                                    }

                                    <a class="dropdown-item text-danger" href="/Animal/Delete/${row.Id}">Excluir</a>
                                </div>
                            </div>`;

                            return dropdown;
                        }
                    }
                ],
                // Ajuste opcional para converter os parâmetros do DataTable
                // para a sintaxe do OData ($skip e $top)
                preXhr: function (settings, data) {
                    data.$skip = data.start;
                    data.$top = data.length;
                    data.$expand = "TipoAnimal";

                    // Opcional: Adiciona busca se houver texto no campo Search
                    if (data.search.value) {
                        data.$filter = "contains(Nome, '" + data.search.value + "')";
                    }
                }
            });
            $('#mostrarAdotados').on('change', function() {
                var colIdx = @(User.IsInRole("ADMIN") ? 7 : 6);
                table.column(colIdx).visible($(this).is(':checked'));
                table.ajax.reload();
            });

            $(document).on('click', '.btn-adocao', function() {
                var id = $(this).data('id');
                window.location.href = '/Animal/Adotado/' + id;
            });
        });
    </script>
}