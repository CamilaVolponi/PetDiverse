@model IEnumerable<PetDiverse.Data.Animal>

@{
    ViewData["Title"] = "Index";
    bool isAdmin = User.IsInRole("ADMIN");
}
<h1 class="text-center">@(isAdmin ? "Todos os animais" : "Meus animais")</h1>
<div class="row">
    <div class="col-md-10">
        <p>
            <a asp-action="Create" class="btn btn-roxo">+ Adicionar</a>
        </p>
    </div>
    <div class="col-md-2 d-flex align-items-center">
        <input type="checkbox" id="mostrarAdotados" class="form-check-input me-2" />
        <label for="mostrarAdotados" class="form-check-label">Mostrar adotados</label>
    </div>
</div>
<table class="table" id="tabelaAnimais">
    <thead>
        <tr>
            <th>
                Nome
            </th>
            <th>
                Idade
            </th>
            <th>
                Sexo biológico
            </th>
            <th>
                Porte
            </th>
            <th>
                Tipo de animal
            </th>
            <th>
                Raça
            </th>
            @if (User.IsInRole("ADMIN"))
            {
                <th>
                    Doador
                </th>
            }
            <th>
                Adotado
            </th>
            <th>
                Ações
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr class="animal-row" data-adotado="@item.Adotado.ToString().ToLower()">
            <td>
                <a class="link-roxo" asp-action="Details" asp-route-id="@item.Id">@Html.DisplayFor(modelItem => item.Nome)</a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Idade) @item.ContagemIdade.ToString().ToLower()
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SexoBiologico)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Porte)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipoAnimal.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Raca.Descricao)
            </td>
            @if (User.IsInRole("ADMIN"))
            {
                <td>
                    <a class="link-roxo" asp-controller="PessoaDoadora" asp-action="Details" asp-route-id="@item.PessoaDoadora.Id">@item.PessoaDoadora?.Nome</a>
                </td>
            }
            <td>
                @if (item.Adotado)
                {
                    <span>Adotado</span>
                }
                else
                {
                    <span>Ainda não foi adotado</span>
                }
            </td>
            <td>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-roxo" type="button" id="dropdownMenuButton_@item.Id" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> </button>
                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton_@item.Id">
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a class="dropdown-item" asp-controller="RegistroVacina" asp-route-idAnimal="@item.Id">Vacinas</a>
                        <a class="dropdown-item" asp-controller="RegistroCirurgia" asp-route-idAnimal="@item.Id">Cirurgias</a>
                        @if (!item.Adotado)
                        {
                            <button class="dropdown-item btn-adocao" animal-id="@item.Id">Foi adotado</button>
                        }
                        <a class="dropdown-item" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </div>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {    
    <script>
        $(document).ready(function () {

            var table = $("#tabelaAnimais").DataTable({
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                drawCallback: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                initComplete: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                }
            });

            // Filtro de adotados
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var mostrar = $("#mostrarAdotados").is(":checked");
                var row = table.row(dataIndex).node();
                var adotado = $(row).data("adotado") === true;
                return mostrar || !adotado;
            });

            $("#mostrarAdotados").change(function () {
                table.draw();
            });

            // Botão "Foi adotado"
            $(".btn-adocao").click(function () {
                $.post('/Animal/Adotado', { id: $(this).attr("animal-id") }, function () {
                    window.location.reload();
                });
            });

        });
    </script>
}