@model IEnumerable<PetDiverse.Data.Bairro>

@{
    ViewData["Title"] = "Bairros";
}

<h1 class="text-center">Bairros</h1>

<p>
    <a asp-action="Create" class="btn btn-roxo">+ Adicionar</a>
</p>
<table class="table" id="tabelaBairros">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Cidade</th>
            <th>Ações</th>
        </tr>
    </thead>
</table>


@section Scripts {
    <script>
        $(document).ready(function () {
            $("#tabelaBairros").DataTable({
                order: [[0, "asc"]],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                lengthChange: false,
                pageLength: 10,
                drawCallback: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                initComplete: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                serverSide: true,
                processing: true,
                ajax: {
                    url: "/odata/Bairro",
                    type: "GET",
                    data: function (d) {
                        var params = {
                            "$count": "true",
                            "$skip": d.start,
                            "$top": d.length,
                            "$expand": "Cidade",
                        };

                        // Ordenação
                        var colunas = ["Nome", "Cidade/Nome"];
                        if (d.order && d.order.length > 0) {
                            var colIdx = d.order[0].column;
                            var dir = d.order[0].dir;
                            var colName = colunas[colIdx];
                            if (colName) {
                                params["$orderby"] = colName + " " + dir;
                            }
                        }

                        // Filtro de busca
                        if (d.search.value) {
                            params["$filter"] = "contains(Nome, '" + d.search.value + "')";
                        }

                        return params;
                    },
                    dataSrc: "value",
                    dataFilter: function (data) {
                        var json = jQuery.parseJSON(data);
                        json.recordsTotal = json["@@odata.count"];
                        json.recordsFiltered = json["@@odata.count"];
                        return JSON.stringify(json);
                    }
                },
                columns: [
                    { data: "Nome" },
                    {
                        data: "Cidade.Nome",
                        defaultContent: "Não informada"
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            let dropdown = `
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-roxo" type="button" id="dropdownMenuButton_${row.Id}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton_${row.Id}">
                                    <a class="dropdown-item" href="/Bairro/Edit/${row.Id}">Editar</a>
                                    <a class="dropdown-item text-danger" href="/Bairro/Delete/${row.Id}">Excluir</a>
                                </div>
                            </div>`;
                            return dropdown;
                        }
                    }
                ]
            });
        });
    </script>
}