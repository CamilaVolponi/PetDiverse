@model PetDiverse.Data.PessoaDoadora
@{
    ViewData["Title"] = "Desativar usuário";
    var pessoaFisica = Model as PetDiverse.Data.PessoaFisica;
    var pessoaJuridica = Model as PetDiverse.Data.PessoaJuridica;
}

<h2>Desativar usuário</h2>
<p class="text-muted">Tem certeza que deseja desativar este usuário?</p>
<hr />

<div class="row">
    <div class="col-md-9">
        <dl class="row">
            <!-- Nome -->
            <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd class="col-sm-7">@Html.DisplayFor(model => model.Nome)</dd>
            <!-- E-mail -->
            <dt class="col-sm-5">E-mail</dt>
            <dd class="col-sm-7">@ViewData["Email"]</dd>
            <!-- Telefone -->
            <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Telefone)</dt>
            <dd class="col-sm-7">@Html.DisplayFor(model => model.Telefone)</dd>
            <!-- Pessoa Física -->
            @if (pessoaFisica != null)
            {
                <dt class="col-sm-5">@Html.DisplayNameFor(model => pessoaFisica.CPF)</dt>
                <dd class="col-sm-7">@pessoaFisica.CPF</dd>
                <dt class="col-sm-5">@Html.DisplayNameFor(model => pessoaFisica.DataNascimento)</dt>
                <dd class="col-sm-7">@pessoaFisica.DataNascimento.ToShortDateString()</dd>
            }
            <!-- Pessoa Jurídica -->
            @if (pessoaJuridica != null)
            {
                <dt class="col-sm-5">@Html.DisplayNameFor(model => pessoaJuridica.CNPJ)</dt>
                <dd class="col-sm-7">@pessoaJuridica.CNPJ</dd>
                <dt class="col-sm-5">@Html.DisplayNameFor(model => pessoaJuridica.RedeSocial)</dt>
                <dd class="col-sm-7">@pessoaJuridica.RedeSocial</dd>
                <dt class="col-sm-5">@Html.DisplayNameFor(model => pessoaJuridica.Site)</dt>
                <dd class="col-sm-7">@pessoaJuridica.Site</dd>
            }
            <!-- Localização -->
            <dt class="col-sm-5">Estado</dt>
            <dd class="col-sm-7">@Model.Bairro?.Cidade?.Estado?.Nome</dd>
            <dt class="col-sm-5">Cidade</dt>
            <dd class="col-sm-7">@Model.Bairro?.Cidade?.Nome</dd>
            <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Bairro)</dt>
            <dd class="col-sm-7">@Model.Bairro?.Nome</dd>
            <!-- Formas de Contato -->
            <dt class="col-sm-5">Formas de Contato</dt>
            <dd class="col-sm-7">
                @if (Model.FormasContato != null && Model.FormasContato.Any())
                {
                    @string.Join(", ", Model.FormasContato.Select(f => f.TipoFormaContato.ToString()))
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>
        </dl>
    </div>
</div>

@{
    var animaisNaoAdotados = ViewData["AnimaisNaoAdotados"] as List<PetDiverse.Data.Animal>;
}
@if (animaisNaoAdotados != null && animaisNaoAdotados.Any())
{
    <div class="alert alert-warning mb-3">
        <strong>Atenção:</strong> os animais abaixo não foram adotados e serão <strong>excluídos permanentemente</strong> ao desativar este usuário.
    </div>
    <table class="table table-sm mb-4">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Raça</th>
                <th>Porte</th>
                <th>Sexo biológico</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var animal in animaisNaoAdotados)
            {
                <tr>
                    <td>@animal.Nome</td>
                    <td>@animal.TipoAnimal?.Descricao</td>
                    <td>@animal.Raca?.Descricao</td>
                    <td>@animal.Porte</td>
                    <td>@animal.SexoBiologico</td>
                </tr>
            }
        </tbody>
    </table>
}

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <a asp-action="Index" class="btn btn-cinza">Voltar a lista</a>
    <input type="submit" value="Desativar" class="btn btn-danger" />
</form>