@model IEnumerable<PetDiverse.Data.TipoCirurgia>

@{
    ViewData["Title"] = "Tipos de cirurgias";
}

<h1 class="text-center">Tipos de cirurgias</h1>

<p>
    <a asp-action="Create" class="btn btn-roxo">+ Adicionar</a>
</p>

<table class="table" id="tabelaTipoCirurgias">
    <thead>
        <tr>
            <th>Tipo de cirurgia</th>
            <th>Tipo de animal</th>
            <th>Ações</th>
        </tr>
    </thead>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#tabelaTipoCirurgias").DataTable({
                order: [[0, "asc"]],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                lengthChange: false,
                pageLength: 10,
                drawCallback: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                initComplete: function () {
                    $(".dt-paging .pagination").addClass("pagination-roxo");
                },
                serverSide: true,
                processing: true,
                ajax: {
                    url: "/odata/TipoCirurgia",
                    type: "GET",
                    data: function (d) {
                        var params = {
                            "$count": "true",
                            "$skip": d.start,
                            "$top": d.length,
                            "$expand": "TipoAnimal",
                        };

                        var colunas = ["Descricao", "TipoAnimal/Descricao"];
                        if (d.order && d.order.length > 0) {
                            var colIdx = d.order[0].column;
                            var dir = d.order[0].dir;
                            var colName = colunas[colIdx];
                            if (colName) {
                                params["$orderby"] = colName + " " + dir;
                            }
                        }

                        if (d.search.value) {
                            params["$filter"] = "contains(Descricao, '" + d.search.value + "')";
                        }

                        return params;
                    },
                    dataSrc: "value",
                    dataFilter: function (data) {
                        var json = jQuery.parseJSON(data);
                        json.recordsTotal = json["@@odata.count"];
                        json.recordsFiltered = json["@@odata.count"];
                        return JSON.stringify(json);
                    }
                },
                columns: [
                    { data: "Descricao" },
                    {
                        data: "TipoAnimal.Descricao",
                        defaultContent: "Não informado"
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            let dropdown = `
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-roxo" type="button" id="dropdownMenuButton_${row.Id}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton_${row.Id}">
                                    <a class="dropdown-item" href="/TipoCirurgia/Edit/${row.Id}">Editar</a>
                                    <a class="dropdown-item text-danger" href="/TipoCirurgia/Delete/${row.Id}">Excluir</a>
                                </div>
                            </div>`;
                            return dropdown;
                        }
                    }
                ]
            });
        });
    </script>
}